{
    "version": 3,
    "configurePresets": [
        {
            "name": "lc-voltage",
            "displayName": "LC-ESC voltage-mode servo",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "lc-voltage-debug",
            "displayName": "LC-ESC voltage-mode servo (Debug)",
            "inherits": "lc-voltage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
